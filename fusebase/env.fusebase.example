VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_BACKEND_URL=https://your-sync-service.onrender.com
VITE_API_BASE_URL=https://your-sync-service.onrender.com

# Sync service only (never in the FuseBase app)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
